{
  "name": "PostPilot — Publish Ready Post",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "publish-ready-post",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-260, 0],
      "id": "pub-webhook-0001-0001-000000000001",
      "name": "Webhook",
      "webhookId": "pub-webhook-0001-0001-000000000001"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.instagram.com/v24.0/{{ $('Webhook').item.json.body.ig_business_id }}/media",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "image_url", "value": "={{ $('Webhook').item.json.body.image_url }}" },
            { "name": "caption", "value": "={{ $('Webhook').item.json.body.caption }}" },
            { "name": "access_token", "value": "={{ $('Webhook').item.json.body.access_token }}" }
          ]
        },
        "options": {}
      },
      "id": "pub-create-0002-0002-000000000002",
      "name": "IG Create Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [-40, 0]
    },
    {
      "parameters": { "resume": "timeInterval", "amount": 15, "unit": "seconds" },
      "id": "pub-wait-0003-0003-000000000003",
      "name": "Wait 15s (IG processing)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [180, 0],
      "webhookId": "pub-wait-webhook-0003-000000000003"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.instagram.com/v24.0/{{ $('Webhook').item.json.body.ig_business_id }}/media_publish",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "creation_id", "value": "={{ $('IG Create Container').item.json.id }}" },
            { "name": "access_token", "value": "={{ $('Webhook').item.json.body.access_token }}" }
          ]
        },
        "options": {}
      },
      "id": "pub-publish-0004-0004-000000000004",
      "name": "IG Publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [400, 0]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://eplpntdzdnvpnzfvamqx.supabase.co/rest/v1/post_logs?id=eq.{{ $('Webhook').item.json.body.post_log_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "YOUR_SUPABASE_SERVICE_KEY" },
            { "name": "Authorization", "value": "Bearer YOUR_SUPABASE_SERVICE_KEY" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: \"published\", published_at: $now.toISO() }) }}",
        "options": {}
      },
      "id": "pub-update-0005-0005-000000000005",
      "name": "Update post_logs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [620, 0]
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook": { "main": [[{ "node": "IG Create Container", "type": "main", "index": 0 }]] },
    "IG Create Container": { "main": [[{ "node": "Wait 15s (IG processing)", "type": "main", "index": 0 }]] },
    "Wait 15s (IG processing)": { "main": [[{ "node": "IG Publish", "type": "main", "index": 0 }]] },
    "IG Publish": { "main": [[{ "node": "Update post_logs", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "id": "PostPilotPublishReady01",
  "tags": []
}
