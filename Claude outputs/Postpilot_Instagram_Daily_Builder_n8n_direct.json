    {
      "parameters": {
        "jsCode": "// The AI returns a JSON object as a string. Parse it and pull out the fields we need.\nconst raw = ($input.first().json.choices && $input.first().json.choices[0] && $input.first().json.choices[0].message && $input.first().json.choices[0].message.content) || \"\";\n\nlet data;\ntry {\n  // Strip any accidental markdown code fences before parsing\n  const cleaned = raw.replace(/^\\s*```(?:json)?/i, \"\").replace(/```\\s*$/i, \"\").trim();\n  data = JSON.parse(cleaned);\n} catch (e) {\n  // Fallback: if it is not valid JSON, treat the whole text as the caption\n  data = { topic: \"\", image_keywords: \"construction building india\", caption: raw, hashtags: \"\" };\n}\n\nreturn [{\n  json: {\n    topic: data.topic || \"\",\n    image_keywords: data.image_keywords || \"construction building india\",\n    caption: data.caption || \"\",\n    hashtags: data.hashtags || \"\",\n  },\n}];"
      },
