    {
      "parameters": {
        "jsCode": "// Convert markdown emphasis into Unicode characters that render as bold/italic on Instagram & Facebook\nfunction convert(text, upperBase, lowerBase, digitBase) {\n  let out = \"\";\n  for (const ch of text) {\n    const code = ch.codePointAt(0);\n    if (code >= 65 && code <= 90) {\n      out += String.fromCodePoint(upperBase + (code - 65));\n    } else if (code >= 97 && code <= 122) {\n      out += String.fromCodePoint(lowerBase + (code - 97));\n    } else if (digitBase && code >= 48 && code <= 57) {\n      out += String.fromCodePoint(digitBase + (code - 48));\n    } else {\n      out += ch;\n    }\n  }\n  return out;\n}\n\nconst bold = (t) => convert(t, 0x1D5D4, 0x1D5EE, 0x1D7EC);\nconst italic = (t) => convert(t, 0x1D608, 0x1D622, 0);\n\nreturn $input.all().map((item) => {\n  let caption = item.json.caption || \"\";\n  const hashtags = (item.json.hashtags || \"\").trim();\n\n  // **bold** first (consumes the double asterisks)\n  caption = caption.replace(/\\*\\*([^*]+?)\\*\\*/g, (m, p1) => bold(p1));\n  // *italic* next\n  caption = caption.replace(/\\*([^*]+?)\\*/g, (m, p1) => italic(p1));\n  // strip leftover markdown emphasis chars, but keep # so hashtags survive\n  caption = caption.replace(/[*_`]/g, \"\");\n  // remove markdown header hashes only at the start of a line (not hashtags)\n  caption = caption.replace(/^#{1,6}\\s+/gm, \"\");\n  // collapse 3+ blank lines down to a single blank line\n  caption = caption.replace(/\\n{3,}/g, \"\\n\\n\").trim();\n\n  // INSTAGRAM caption = text + full hashtag block (hashtags help discovery on IG)\n  const captionIG = hashtags ? caption + \"\\n\\n\" + hashtags : caption;\n  // FACEBOOK caption = text only, NO hashtag block (big hashtag walls look spammy on FB)\n  const captionFB = caption;\n\n  return { json: Object.assign({}, item.json, { caption: captionIG, caption_fb: captionFB }) };\n});"
      },
