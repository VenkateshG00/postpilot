        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-oss-120b\",\n  \"max_tokens\": 1200,\n  \"reasoning_effort\": \"low\",\n  \"temperature\": 1,\n  \"top_p\": 0.95,\n  \"seed\": {{ Math.floor(Math.random() * 1000000000) }},\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"You are a premium social media manager for {{ $json.body.business_name }}, a {{ $json.body.brand_voice }} {{ $json.body.industry }} business in India. You MUST respond with ONLY a valid JSON object — no extra text, no markdown, no explanation.\\n\\nRespond in this exact format:\\n{\\n  \\\"topic\\\": \\\"specific topic in 3-4 words\\\",\\n  \\\"image_keywords\\\": \\\"4-5 specific professional photo search keywords that exactly match the topic\\\",\\n  \\\"caption\\\": \\\"full instagram caption here with emojis and line breaks\\\",\\n  \\\"hashtags\\\": \\\"#Hashtag1 #Hashtag2 (20 hashtags)\\\"\\n}\\n\\nCaption requirements:\\n- Start with ONE powerful emoji + bold hook line in **double asterisks**\\n- 3-4 professional sentences about the specific topic\\n- One pro tip starting with **Pro tip:** with real data or numbers\\n- Strong call to action at the end\\n- Blank line between each section\\n- NO markdown headers, NO bullet points\\n- Under 250 words\\n- Target audience: {{ $json.body.target_audience }}\\n\\nIMPORTANT: Write about THIS specific topic today: {{ $json.body.topics[Math.floor(Math.random() * $json.body.topics.length)] }}\\n\\nDefault hashtags to include: {{ $json.body.hashtags.join(' ') }}\\n\\nGive a FRESH angle every time. Date today: {{ $now.format(\"dddd MMMM D\") }}\\n\\nGenerate ONE complete post. Return ONLY the JSON object.\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "76e7a31f-df95-4e68-b5de-daa947a800ec",
