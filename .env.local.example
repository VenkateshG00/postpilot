# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta / Facebook App
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
NEXT_PUBLIC_META_APP_ID=your-meta-app-id

# n8n / Make.com webhook base URL
N8N_WEBHOOK_BASE_URL=https://your-n8n-instance/webhook
MAKE_WEBHOOK_BASE_URL=https://hook.eu1.make.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (Phase 4 — billing)
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_PRICE_STARTER=price_xxx_starter
STRIPE_PRICE_PRO=price_xxx_pro
STRIPE_PRICE_AGENCY=price_xxx_agency

# Razorpay (Phase 4 — billing, India) — replaces Stripe
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
RAZORPAY_PLAN_STARTER=plan_xxx_starter
RAZORPAY_PLAN_PRO=plan_xxx_pro
RAZORPAY_PLAN_AGENCY=plan_xxx_agency
